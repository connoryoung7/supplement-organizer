# Local runtime
PORT=3000
RUST_LOG=info

# Postgres. `just db` starts one locally with exactly these credentials.
# (`just run` / `just up` override this to reach that database from inside Docker.)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/supplement_organizer

# IANA time zone that decides when "today" rolls over, e.g. America/New_York. Default UTC.
TZ=UTC

# Image registry (Dokploy pulls from here when the app's source is "Docker")
# e.g. ghcr.io/<user>/supplement-organizer or docker.io/<user>/supplement-organizer
IMAGE=ghcr.io/your-user/supplement-organizer

# Dokploy — option A: API (Settings -> Profile -> API/CLI -> Generate token)
DOKPLOY_URL=https://dokploy.example.com
DOKPLOY_API_KEY=
DOKPLOY_APP_ID=

# Dokploy — option B: deploy webhook (Application -> Deployments -> Webhook URL)
DOKPLOY_WEBHOOK_URL=
